# Hammerhead Connector Environment Variables
# OAuth2 client credentials issued by Hammerhead when you register an API client.
# How often to poll for new activities, in seconds. Default = 1800 (aka 30 minutes)
HAMMERHEAD_CLIENT_ID=your-client-id
HAMMERHEAD_CLIENT_SECRET=your-client-secret
HAMMERHEAD_POLL_INTERVAL=1800